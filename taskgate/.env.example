# Copy to .env and fill in. The task gate runs on the cloud VPS next to the
# backend. Only the worker WebSocket is exposed (through nginx); POST /task
# and /admin/* are for processes on the same machine.

# -- Bind --------------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# -- Secrets -----------------------------------------------------------------
# Workers connect to /ws/worker?token=<WORKER_TOKEN>&worker=<device id>
WORKER_TOKEN=change-me
# X-Admin-Key for /admin/* (status, history, test task, retry, cancel)
ADMIN_KEY=change-me-admin-key
# X-Ext-Auth for the backup browser-extension pool (/ext/*)
EXT_AUTH=change-me-ext-password
# Fernet key that encrypts live tasks and the results outbox on disk:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TASKS_KEY=

# -- Telegram (optional: one card per task, edited as it moves) ---------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -- Power gate (the cloud gate: wake a sleeping laptop, keep it awake) -------
# Leave empty to run without power control.
POWER_GATE_URL=http://127.0.0.1:8201
POWER_GATE_KEY=

# -- Callbacks ---------------------------------------------------------------
CALLBACK_RETRIES=3
CALLBACK_RETRY_DELAY=2
CALLBACK_TIMEOUT=15
OUTBOX_MAX_AGE_S=86400
OUTBOX_MAX_GAP_S=300

# -- Routing (router.py) -------------------------------------------------------
# The "main" device swaps every MAIN_SWAP_S on SWAP_TZ wall-clock time;
# LOGIN_PRIMARY is the main in even slots.
LOGIN_PRIMARY=1
MAIN_SWAP_S=21600
SWAP_TZ=UTC
LOGIN_CAP=5
BATCH_CAP=3
PAYMENT_CAP=3
LOGIN_MAX_ATTEMPTS=10
LOGIN_MAX_TOTAL_S=1800
BATCH_MAX_TRIES=2
WAKE_TIMEOUT_S=240
WAKE_COOLDOWN_S=180
ACK_TIMEOUT_S=30
HOLD_MAX_S=600
QUEUE_MAX_S=300
STATUS_STALE_S=60
LOOP_STALE_S=60
DISCONNECT_GRACE_S=20

# -- Display -----------------------------------------------------------------
GATE_TZ=UTC
REF_TZ=UTC
HISTORY_MAX=100
EXT_TASK_TTL=1800
