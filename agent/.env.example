# Copy to .env and fill in. Runs on each device (Windows 10/11) as the
# LocalServerCore service. One .env per device.

# -- Identity ---------------------------------------------------------------
# 1 or 2
DEVICE_ID=1
# HOST_NAME defaults to the Windows computer name
# HOST_NAME=laptop1

# -- Gate (direct IP, no domain) --------------------------------------------
# the VPS public IP. Port 443: nginx's default_server (bare IP, no SNI) serves
# the gate's self-signed cert and proxies /agent/ws + /status to the gate on
# loopback 8201 (the cloud provider's firewall only passes 22/80/443).
GATE_IP=203.0.113.10
GATE_PORT=443
# TLS on: pin the self-signed cert below. First run logs
# "gate cert NOT pinned - set GATE_TLS_FINGERPRINT=<sha256>" - copy that in.
GATE_TLS=true
GATE_TLS_FINGERPRINT=
# Optional overrides:
# CONTROL_URL=wss://203.0.113.10:443/agent/ws
# STATUS_URL=https://203.0.113.10:443/status

# -- Auth (must match AGENT_TOKEN on the gate .env) ---------------------------
AGENT_TOKEN=

# -- Timing -------------------------------------------------------------------
STATUS_INTERVAL=60
RECONNECT_MIN=2
RECONNECT_MAX=30

# -- Overheat kill switch -----------------------------------------------------
MAX_TEMP_C=90
TEMP_GRACE=30

# -- Network topology (three separate WANs) -----------------------------------
# wifi = main DSL router SSID (the radio)
# eth  = the NEW router over the Ethernet cable (its own WAN)
# sms  = SMS box over its Wi-Fi hotspot (USB tether = fallback)
WIFI_DSL_SSID=
WIFI_SMS_SSID=
ETH_ADAPTER=Ethernet

# -- Warm checks / keepalive --------------------------------------------------
NET_SECOND_CHECK_ENABLED=true
NET_SECOND_CHECK_INTERVAL=600
SMS_KEEPALIVE_ENABLED=true
SMS_KEEPALIVE_INTERVAL=180
SMS_KEEPALIVE_HOLD_SEC=20

# -- Auto failover when internet dies ------------------------------------------
NET_WATCH_ENABLED=true
NET_WATCH_INTERVAL=30
NET_FAIL_THRESHOLD=3

# -- AC / battery alert ---------------------------------------------------------
POWER_WATCH_ENABLED=true
POWER_WATCH_INTERVAL=15

# -- Remote desktop -------------------------------------------------------------
ANYDESK_PATH=C:\Program Files (x86)\AnyDesk\AnyDesk.exe
ANYDESK_WATCH_ENABLED=true
# RUSTDESK_PATH=C:\Users\<you>\AppData\Local\rustdesk\rustdesk.exe
# RUSTDESK_ID=

# -- Display ----------------------------------------------------------------------
DIM_BACKLIGHT_ON_START=false

# -- Smart plugs (LAN, both plugs on every device) ---------------------------------
# OpenBeken: PLUGn_HOST (fixed DHCP address) and PLUGn_PASS (plug web password,
# user admin). Socket = channel 1, lamp = channel 2.
# PLUG1_HOST=192.168.0.5
# PLUG1_PASS=
# PLUG2_HOST=192.168.0.4
# PLUG2_PASS=

# -- Network boxes (reboot for a fresh public IP) ----------------------------------
ROUTER_DSL_HOST=192.168.0.1
ROUTER_DSL_USER=
ROUTER_DSL_PASS=
ROUTER_SMS_HOST=192.168.0.254
ROUTER_SMS_USER=
ROUTER_SMS_PASS=
# The NEW router (eth). Reboot trigger is a placeholder until its UI is
# discovered at deploy - fill the host anyway for reachability status.
# ROUTER_ETH_HOST=
# ROUTER_ETH_USER=
# ROUTER_ETH_PASS=
ROUTER_REBOOT_WAIT=120
ROUTER_REBOOT_MIN_INTERVAL_S=1800
