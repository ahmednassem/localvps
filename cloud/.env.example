# Copy to .env and fill in. Runs on the VPS (Linux), directory /root/localserver/cloud.
#
# Agents connect straight to the server IP (no domain): https://203.0.113.10:443.
# nginx's default_server (bare-IP/no-SNI connections) serves the self-signed
# cert in certs/ and proxies ONLY /agent/ws + /status to this gate on
# loopback 8201 — the admin and /out APIs stay loopback-only. the cloud provider's
# firewall only passes 22/80/443, so the gate itself binds 127.0.0.1.

# ── Telegram admin bot ──────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=
# Your personal Telegram user ID (the single admin allowed to control devices)
ADMIN_USER_ID=

# ── Tunnel auth (must match the device agents' .env) ────────────────────────
AGENT_TOKEN=
# Secret required in the X-Admin-Key header for the admin HTTP API
ADMIN_KEY=
# Key for the /out/v1 output API (web view + control; loopback only).
# Defaults to ADMIN_KEY when empty.
OUT_API_KEY=

# ── Gate bind — loopback; nginx terminates TLS on 443 for the agents ────────
HTTP_HOST=127.0.0.1
GATE_PORT=8201
# Direct-TLS mode (no nginx): set these and point agents at the port instead.
SSL_CERTFILE=
SSL_KEYFILE=

# ── Devices ─────────────────────────────────────────────────────────────────
# 1 or 2
DEVICE1_LABEL=laptop1
DEVICE2_LABEL=laptop2

# ── Smart plugs (OpenBeken, over MQTT) — one per device ──────────
# Each plug connects to the Mosquitto broker on the VPS by itself (port 80 is
# redirected to 1883). Socket = channel 1, night lamp = channel 2 (on/off).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=gate
MQTT_PASS=
PLUG1_MQTT_TOPIC=plug1
PLUG2_MQTT_TOPIC=plug2
PLUG1_RELAY_CH=1
PLUG2_RELAY_CH=1
PLUG1_LAMP_CH=2
PLUG2_LAMP_CH=2
# SSIDs the plugs use: main router first, SMS box as backup
PLUG_WIFI_MAIN=
PLUG_WIFI_BACKUP=
# Below this wattage with socket on = nothing really drawing (laptop off/idle)
PLUG_MIN_WATTS=5
# Seconds the socket stays off during /power cycle and dead-man recovery
PLUG_CYCLE_WAIT=10
# Seconds between reads of the plugs' MQTT state
PLUG_POLL_S=60

# ── Watchdog / dead-man switch (per device) ─────────────────────────────────
# Seconds without a status before a device is considered off/hung
DEADMAN_GRACE=150
# Soft temperature warning threshold (Celsius) reported via telemetry
TEMP_WARN_C=85

# ── Telegram auto-reports ────────────────────────────────────────────────────
# Send /status-style digest (all devices) every N seconds (1800 = 30 minutes)
STATUS_REPORT_INTERVAL=1800
# Resource warning thresholds (%)
CPU_WARN_PCT=90
RAM_WARN_PCT=90
DISK_WARN_PCT=90
BATTERY_LOW_PCT=20

# ── Idle watch (shutdown after no tasks + wake-on-task, per device) ─────────
# NIGHT_ALWAYS=true applies the idle rule all day (no day/night shift).
# With it off, the rule only applies between NIGHT_START and NIGHT_END.
NIGHT_ALWAYS=true
NIGHT_START=23
NIGHT_END=9
NIGHT_IDLE_MINUTES=30

# ── Net rotation (IP rotation, per device) ──────────────────────────
NETROTATE_ENABLED=true
NETROTATE_EVERY_TASKS=20
NETROTATE_REJECT_STREAK=3
NETROTATE_REPORT_EVERY=100
NETROTATE_DEAD_PENALTY_TASKS=50
NETROTATE_COOLDOWN_S=300
NETROTATE_MAX_DEFER_S=300
NETROTATE_REBOOT_DSL=true
NETROTATE_REBOOT_ETH=false
NETROTATE_REBOOT_SMS=false

# ── lsvc device feed (which device is working → local services gate) ────────
LSVC_URL=http://127.0.0.1:8102
# lsvc admin key (LSVC's ADMIN_KEY); empty disables the feed
LSVC_KEY=

# ── Scheduler (cloud cron jobs → device / plug / notify) ────────────────────
# Cron times in schedule.json use this timezone (server may be UTC).
SCHEDULE_TZ=UTC
# Path to schedule.json (default: next to main.py)
# SCHEDULE_FILE=

LOG_LEVEL=INFO
